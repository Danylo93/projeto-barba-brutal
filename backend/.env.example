# Cópia deste arquivo vira o .env local. Aqui só entra PLACEHOLDER —
# chave de API, senha e connection string ficam em variável de ambiente.

# ─────────────────────────────── banco ───────────────────────────────
# No Neon: DATABASE_URL é a URL "pooled" (-pooler) e DIRECT_URL é a direta,
# usada pelas migrations. Local: as duas iguais.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# ─────────────────────────────── auth ────────────────────────────────
JWT_SECRET="troque-por-algo-longo-e-aleatorio"

# Origens do frontend, separadas por vírgula (produção + previews da Vercel).
# Também é a base dos links que vão nos e-mails.
FRONTEND_URL="http://localhost:3000"

# ──────────────────────────────── e-mail ─────────────────────────────
# Há dois canais. O Resend tem preferência quando a chave está definida.
#
# 1) Resend — API HTTP na porta 443.
#
#    É o que funciona no Render: desde setembro/2025 o plano free bloqueia a
#    saída nas portas de SMTP (25, 465 e 587), e qualquer smtp.* dá
#    "Connection timeout" sem enviar nada.
#
#    O remetente precisa estar num domínio verificado no Resend, senão a API
#    responde 403. Verifique barbabrutal.com.br lá e use um endereço dele.
RESEND_API_KEY=""
EMAIL_FROM="Barbearia Brutal <suporte@barbabrutal.com.br>"

# 2) SMTP — alternativa, para rodar local ou em host que não bloqueie a porta.
#    Só é usado quando RESEND_API_KEY está vazia.
#    No Gmail, SMTP_PASS é uma "senha de app" (16 caracteres, sem os espaços
#    que o Google mostra na tela).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Confira se o e-mail sai: GET /health/email com token de admin.

# ───────────────────────── pagamento (Mercado Pago) ──────────────────
MERCADO_PAGO_ACCESS_TOKEN=""

# ──────────────────────── WhatsApp (Evolution API) ───────────────────
EVOLUTION_URL=""
EVOLUTION_APIKEY=""
EVOLUTION_INSTANCE=""
