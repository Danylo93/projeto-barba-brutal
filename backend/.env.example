# Cópia deste arquivo vira o .env local. Aqui só entra PLACEHOLDER —
# chave de API, senha e connection string ficam em variável de ambiente.

# ─────────────────────────────── banco ───────────────────────────────
# No Neon: DATABASE_URL é a URL "pooled" (-pooler) e DIRECT_URL é a direta,
# usada pelas migrations. Local: as duas iguais.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# ─────────────────────────────── auth ────────────────────────────────
JWT_SECRET="troque-por-algo-longo-e-aleatorio"

# Origens do frontend, separadas por vírgula (produção + previews da Vercel).
# Também é a base dos links que vão nos e-mails.
FRONTEND_URL="http://localhost:3000"

# ──────────────────────────────── e-mail ─────────────────────────────
# Há dois canais. O Resend tem preferência quando a chave está definida.
#
# 1) Resend — API HTTP na porta 443.
#
#    É o que funciona no Render: desde setembro/2025 o plano free bloqueia a
#    saída nas portas de SMTP (25, 465 e 587), e qualquer smtp.* dá
#    "Connection timeout" sem enviar nada.
#
#    EMAIL_FROM é obrigatório e precisa ser um endereço de domínio JÁ
#    VERIFICADO no Resend — com domínio não verificado a API responde 403 e
#    nenhum e-mail sai. Não há valor padrão de propósito: um domínio chutado
#    trocaria um erro claro por um 403 no meio do envio.
RESEND_API_KEY=""
EMAIL_FROM="Barbearia Brutal <contato@seudominio.com.br>"

# 2) SMTP — alternativa, para rodar local ou em host que não bloqueie a porta.
#    Só é usado quando RESEND_API_KEY está vazia.
#    No Gmail, SMTP_PASS é uma "senha de app" (16 caracteres, sem os espaços
#    que o Google mostra na tela).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Confira se o e-mail sai: GET /health/email com token de admin.

# ───────────────────────── pagamento (Mercado Pago) ──────────────────
MERCADO_PAGO_ACCESS_TOKEN=""

# ──────────────────────── WhatsApp (Evolution API) ───────────────────
# A Evolution precisa responder pela internet: quem chama é o backend, não o
# n8n. Sem as três, o disparo de aviso responde 503 dizendo o que falta — de
# propósito. Marcar como enviado sem ter enviado tiraria o agendamento da fila
# sem ninguém ter sido avisado.
EVOLUTION_URL=""
EVOLUTION_APIKEY=""
EVOLUTION_INSTANCE=""

# ──────────────── avisos de agendamento (n8n → backend) ──────────────
# Segredo que o n8n manda no header `x-lembrete-token` para disparar as
# confirmações e os lembretes. Sem ele as rotas /lembretes ficam desativadas.
LEMBRETE_TOKEN=""

# Segredo por barbearia das ferramentas do agente de IA no n8n. O mapa impede
# que um token de uma instância opere em outro tenant.
WHATSAPP_BOT_TOKENS='{"1":"troque-por-um-segredo-longo"}'

# ─────────────────── bot de WhatsApp (n8n → backend) ─────────────────
# O tenant sai do TOKEN, nunca do `?tenantId=` da URL. Duas formas:
#
# 1) Uma barbearia só: token único + a barbearia dele. As DUAS variáveis são
#    obrigatórias juntas — token global sem barbearia declarada não vale, e é
#    de propósito: essa combinação abria a agenda de todas as barbearias para
#    quem trocasse o número na URL.
WHATSAPP_BOT_TOKEN=""
WHATSAPP_BOT_TENANT_ID=""
#
# 2) Várias barbearias: um token por barbearia.
#    Ex.: {"1":"token-da-um","2":"token-da-dois"}
WHATSAPP_BOT_TOKENS=""
