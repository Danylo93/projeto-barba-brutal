            "index": 0
          }
        ]
      ]
    },
    "Disparar retornos": {
      "main": [
        [
          {
            "node": "Retornos processados",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "timezone": "America/Sao_Paulo"
  },
