# Backend API URL (deve apontar para o servidor NestJS)
NEXT_PUBLIC_URL_BASE=http://localhost:3001

# Backend URL para requisições server-side
BACKEND_URL=http://localhost:3001

# ID padrão do tenant para testes
NEXT_PUBLIC_TENANT_DEFAULT_ID=1


# Domínio raiz do SaaS. Com ele, `latita.barbeariabrutal.com` passa a servir a
# página da barbearia de slug `latita` (ver frontend/src/middleware.ts).
# Vazio desliga o recurso: preview da Vercel e localhost seguem usando
# /barbearia/latita. Ver docs/subdominio-por-barbearia.md.
NEXT_PUBLIC_DOMINIO_RAIZ=
